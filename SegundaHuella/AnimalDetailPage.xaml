<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SegundaHuella.AnimalDetailsPage"
             BackgroundColor="#FEF9F5"
             Title="Detalles del animal">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Barra de navegación superior -->
            <Grid>
                <Button Text="&lt;" HorizontalOptions="Start" WidthRequest="40" HeightRequest="40" CornerRadius="20" BackgroundColor="White" TextColor="Black" FontSize="18" FontAttributes="Bold" Clicked="OnBackButtonClicked"/>
                <Button Text="♡" HorizontalOptions="End" WidthRequest="40" HeightRequest="40" CornerRadius="20" BackgroundColor="White" TextColor="#FF5A5F" FontSize="18" FontAttributes="Bold"/>
            </Grid>

            <!-- Título: Nombre y corazón -->
            <HorizontalStackLayout Spacing="10" VerticalOptions="Center" Margin="0,10,0,0">
                <Label Text="Luna" FontSize="32" FontAttributes="Bold" TextColor="#001F3F"/>
                <Label Text="❤" FontSize="24" TextColor="#FF5A5F" VerticalOptions="Center"/>
            </HorizontalStackLayout>

            <BoxView HeightRequest="1" Color="#E0E0E0" Margin="0,5"/>

            <!-- Cuadrícula de características -->
            <Grid RowDefinitions="Auto, Auto, Auto, Auto" ColumnDefinitions="40, 120, *" RowSpacing="15">
                <!-- Especie -->
                <Label Grid.Row="0" Grid.Column="0" Text="🐾" FontSize="18" VerticalOptions="Center" HorizontalOptions="Center"/>
                <Label Grid.Row="0" Grid.Column="1" Text="Especie:" TextColor="#555555" FontSize="16" VerticalOptions="Center"/>
                <Label Grid.Row="0" Grid.Column="2" Text="Perro" FontAttributes="Bold" TextColor="Black" FontSize="16" VerticalOptions="Center"/>

                <!-- Edad -->
                <Label Grid.Row="1" Grid.Column="0" Text="📅" FontSize="18" VerticalOptions="Center" HorizontalOptions="Center"/>
                <Label Grid.Row="1" Grid.Column="1" Text="Edad:" TextColor="#555555" FontSize="16" VerticalOptions="Center"/>
                <Label Grid.Row="1" Grid.Column="2" Text="3 años" FontAttributes="Bold" TextColor="Black" FontSize="16" VerticalOptions="Center"/>

                <!-- Tamaño -->
                <Label Grid.Row="2" Grid.Column="0" Text="📏" FontSize="18" VerticalOptions="Center" HorizontalOptions="Center"/>
                <Label Grid.Row="2" Grid.Column="1" Text="Tamaño:" TextColor="#555555" FontSize="16" VerticalOptions="Center"/>
                <Label Grid.Row="2" Grid.Column="2" Text="Mediano" FontAttributes="Bold" TextColor="Black" FontSize="16" VerticalOptions="Center"/>

                <!-- Piso pequeño -->
                <Label Grid.Row="3" Grid.Column="0" Text="🏠" FontSize="18" VerticalOptions="Center" HorizontalOptions="Center"/>
                <Label Grid.Row="3" Grid.Column="1" Text="Piso pequeño:" TextColor="#555555" FontSize="16" VerticalOptions="Center"/>
                <Label Grid.Row="3" Grid.Column="2" Text="Sí" FontAttributes="Bold" TextColor="#006D5B" FontSize="16" VerticalOptions="Center"/>
            </Grid>

            <BoxView HeightRequest="1" Color="#E0E0E0" Margin="0,5"/>

            <!-- Personalidad -->
            <HorizontalStackLayout Spacing="10">
                <Label Text="🐾" FontSize="18" VerticalOptions="Center"/>
                <Label Text="Tranquila y cariñosa" FontAttributes="Bold" TextColor="#006D5B" FontSize="16" VerticalOptions="Center"/>
            </HorizontalStackLayout>

            <!-- Espaciador para empujar los botones abajo -->
            <ContentView VerticalOptions="FillAndExpand" MinimumHeightRequest="40"/>

            <!-- Botones de Acción: Me interesa / Contactar -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0, 20, 0, 10">
                <Button Grid.Column="0" Text="♡ Me interesa" TextColor="#006D5B" BackgroundColor="Transparent" BorderColor="#006D5B" BorderWidth="2" CornerRadius="25" HeightRequest="50" FontAttributes="Bold" Clicked="OnInteresaClicked"/>
                <Button Grid.Column="1" Text="✉ Contactar" TextColor="White" BackgroundColor="#FF8C00" CornerRadius="25" HeightRequest="50" FontAttributes="Bold" Clicked="OnContactarClicked"/>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>