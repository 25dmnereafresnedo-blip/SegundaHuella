<ContentPage
    x:Class="SegundaHuella.AnimalDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Detalles del animal"
    BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <Grid>
                <Button
                    BackgroundColor="White"
                    Clicked="OnBackButtonClicked"
                    CornerRadius="20"
                    FontAttributes="Bold"
                    FontSize="18"
                    HeightRequest="40"
                    HorizontalOptions="Start"
                    Text="&lt;"
                    TextColor="Black"
                    WidthRequest="40" />
                <Button
                    BackgroundColor="White"
                    CornerRadius="20"
                    FontAttributes="Bold"
                    FontSize="18"
                    HeightRequest="40"
                    HorizontalOptions="End"
                    Text="♡"
                    TextColor="#FF5A5F"
                    WidthRequest="40" />
            </Grid>

            <Image
                Aspect="AspectFit"
                HeightRequest="280"
                Source="{Binding Imagen}" />
            <HorizontalStackLayout
                Margin="0,10,0,0"
                Spacing="10"
                VerticalOptions="Center">
                <Label
                    FontAttributes="Bold"
                    FontSize="32"
                    Text="{Binding Nombre}"
                    TextColor="#001F3F" />

            </HorizontalStackLayout>

            <BoxView
                Margin="0,5"
                HeightRequest="1"
                Color="#E0E0E0" />
            <Grid
                ColumnDefinitions="40, 120, *"
                RowDefinitions="Auto, Auto, Auto, Auto"
                RowSpacing="15">
                <Label
                    Grid.Row="0"
                    Grid.Column="0"
                    FontSize="18"
                    HorizontalOptions="Center"
                    Text="🐾"
                    VerticalOptions="Center" />
                <Label
                    Grid.Row="0"
                    Grid.Column="1"
                    FontSize="16"
                    Text="Especie:"
                    TextColor="#555555"
                    VerticalOptions="Center" />
                <Label
                    Grid.Row="0"
                    Grid.Column="2"
                    FontAttributes="Bold"
                    FontSize="16"
                    Text="{Binding Especie}"
                    TextColor="Black"
                    VerticalOptions="Center" />
                <Label
                    Grid.Row="1"
                    Grid.Column="0"
                    FontSize="18"
                    HorizontalOptions="Center"
                    Text="📅"
                    VerticalOptions="Center" />
                <Label
                    Grid.Row="1"
                    Grid.Column="1"
                    FontSize="16"
                    Text="Edad:"
                    TextColor="#555555"
                    VerticalOptions="Center" />
                <Label
                    Grid.Row="1"
                    Grid.Column="2"
                    FontAttributes="Bold"
                    FontSize="16"
                    Text="{Binding Edad}"
                    TextColor="Black"
                    VerticalOptions="Center" />
                <Label
                    Grid.Row="2"
                    Grid.Column="0"
                    FontSize="18"
                    HorizontalOptions="Center"
                    Text="📏"
                    VerticalOptions="Center" />
                <Label
                    Grid.Row="2"
                    Grid.Column="1"
                    FontSize="16"
                    Text="Tamaño:"
                    TextColor="#555555"
                    VerticalOptions="Center" />
                <Label
                    Grid.Row="2"
                    Grid.Column="2"
                    FontAttributes="Bold"
                    FontSize="16"
                    Text="{Binding Tamaño}"
                    TextColor="Black"
                    VerticalOptions="Center" />
                <Label
                    Grid.Row="3"
                    Grid.Column="0"
                    FontSize="18"
                    HorizontalOptions="Center"
                    Text="🏠"
                    VerticalOptions="Center" />
                <Label
                    Grid.Row="3"
                    Grid.Column="1"
                    FontSize="16"
                    Text="Piso pequeño:"
                    TextColor="#555555"
                    VerticalOptions="Center" />
                <Label
                    Grid.Row="3"
                    Grid.Column="2"
                    FontAttributes="Bold"
                    FontSize="16"
                    Text="Sí"
                    TextColor="#006D5B"
                    VerticalOptions="Center" />
            </Grid>

            <BoxView
                Margin="0,5"
                HeightRequest="1"
                Color="#E0E0E0" />
            <HorizontalStackLayout Spacing="10">
                <Label
                    FontSize="18"
                    Text="🐾"
                    VerticalOptions="Center" />
                <Label
                    FontAttributes="Bold"
                    FontSize="16"
                    Text="Disponible para adopción"
                    TextColor="#006D5B"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>
            <ContentView MinimumHeightRequest="40" VerticalOptions="FillAndExpand" />
            <Grid
                Margin="0,20,0,10"
                ColumnDefinitions="*, *"
                ColumnSpacing="15">
                <Button
                    Grid.Column="0"
                    BackgroundColor="Transparent"
                    BorderColor="#006D5B"
                    BorderWidth="2"
                    Clicked="OnInteresaClicked"
                    CornerRadius="25"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    Text="♡ Me interesa"
                    TextColor="#006D5B" />
                <Button
                    Grid.Column="1"
                    BackgroundColor="#FF8C00"
                    Clicked="OnContactarClicked"
                    CornerRadius="25"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    Text="✉ Contactar"
                    TextColor="White" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>