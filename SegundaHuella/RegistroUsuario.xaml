<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SegundaHuella.RegistroUsuario"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="RegistroUsuario">
    <VerticalStackLayout Padding="28,45" Spacing="18">
        <Label
            FontAttributes="Bold"
            FontSize="30"
            HorizontalOptions="Center"
            Text="SegundaHuella"
            TextColor="#008F87" />
        <Label
            FontSize="17"
            HorizontalOptions="Center"
            Text="Registro para usuarios"
            TextColor="#34495E" />
        <Entry
            x:Name="NombreEntry"
            BackgroundColor="White"
            Placeholder="Nombre"
            TextColor="#34495E" />

        <Entry
            x:Name="ApellidoEntry"
            BackgroundColor="White"
            Placeholder="Apellido"
            TextColor="#34495E" />

        <Entry
            x:Name="EdadEntry"
            BackgroundColor="White"
            Keyboard="Numeric"
            Placeholder="Edad"
            TextColor="#34495E" />

        <Entry
            x:Name="DireccionEntry"
            BackgroundColor="White"
            Placeholder="Dirección"
            TextColor="#34495E" />

        <Entry
            x:Name="PassEntry"
            BackgroundColor="White"
            HeightRequest="50"
            IsPassword="True"
            IsVisible="True"
            Placeholder="Contraseña"
            TextColor="#34495E" />

        <Button
            BackgroundColor="#FF873D"
            Clicked="RegistrarseClicked"
            CornerRadius="25"
            HeightRequest="52"
            Text="Registrarse"
            TextColor="White" />
    </VerticalStackLayout>
</ContentPage>