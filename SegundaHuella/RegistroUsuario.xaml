<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SegundaHuella.RegistroUsuario"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="RegistroUsuario">
    <VerticalStackLayout Padding="20" Spacing="20">
        <Label
            FontAttributes="Bold"
            FontSize="60"
            HorizontalOptions="Center"
            Text="SegundaHuella"
            TextColor="#008F87" />
        <Label
            FontAttributes="Bold"
            FontSize="17"
            HorizontalOptions="Center"
            Text="Registro para usuarios"
            TextColor="#34495E" />
        <Entry
            x:Name="NombreEntry"
            Placeholder="Nombre"
            TextColor="#34495E" />

        <Entry
            x:Name="ApellidoEntry"
            Placeholder="Apellido"
            TextColor="#34495E" />

        <Entry
            x:Name="EdadEntry"
            Keyboard="Numeric"
            Placeholder="Edad"
            TextColor="#34495E" />

        <Entry
            x:Name="DireccionEntry"
            Placeholder="Dirección"
            TextColor="#34495E" />

        <Entry
            x:Name="PassEntry"
            IsPassword="True"
            Placeholder="Contraseña"
            TextColor="#34495E" />

        <Button
            x:Name="RegistrarButton"
            Padding="-5"
            BackgroundColor="#FF873D"
            Clicked="RegistrarClicked"
            FontAttributes="Bold"
            FontSize="25"
            IsVisible="True"
            Text="Registrarse"
            TextColor="White" />
    </VerticalStackLayout>
</ContentPage>