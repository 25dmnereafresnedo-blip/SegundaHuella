<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SegundaHuella.AnadirAnimalPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Añadir mascota"
    BackgroundColor="White">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label
                FontAttributes="Bold"
                FontSize="30"
                Text="Añadir mascota"
                TextColor="DarkCyan" />

            <Label Text="Completa los datos de la mascota para publicarla en adopción." TextColor="#555555" />
            <Border
                BackgroundColor="White"
                Padding="12,0"
                Stroke="#008F87"
                StrokeThickness="1.5"
                StrokeShape="RoundRectangle 12">
                <Entry
                x:Name="NombreEntry"
                Placeholder="Nombre"
                TextColor="Black" />
            </Border>

            <Border
                BackgroundColor="White"
                Padding="12,0"
                Stroke="#008F87"
                StrokeThickness="1.5"
                StrokeShape="RoundRectangle 12">
                <Picker
                x:Name="EspeciePicker"
                Title="Selecciona la especie"
                SelectedIndexChanged="OnEspecieChanged"
                TextColor="Black"
                TitleColor="Gray">
                <Picker.Items>
                    <x:String>Perro</x:String>
                    <x:String>Gato</x:String>
                    <x:String>Conejo</x:String>
                    <x:String>Ave</x:String>
                    <x:String>Otro</x:String>
                </Picker.Items>
            </Picker>
            </Border>
            <Entry
                x:Name="OtraEspecieEntry"
                IsVisible="False"
                Placeholder="Escribe la especie"
                TextColor="Black" />

            <Border
                BackgroundColor="White"
                Padding="12,0"
                Stroke="#008F87"
                StrokeThickness="1.5"
                StrokeShape="RoundRectangle 12">
                <Entry
                x:Name="EdadEntry"
                Placeholder="Edad"
                TextColor="Black" />
                </Border>

            <Border
                BackgroundColor="White"
                Padding="12,0"
                Stroke="#008F87"
                StrokeThickness="1.5"
                StrokeShape="RoundRectangle 12">
                <Picker
                x:Name="TamanoPicker"
                Title="Selecciona el tamaño"
                TextColor="Black"
                TitleColor="Gray">
                <Picker.Items>
                    <x:String>Pequeño</x:String>
                    <x:String>Mediano</x:String>
                    <x:String>Grande</x:String>
                </Picker.Items>
            </Picker>
            </Border>
            <Button
                BackgroundColor="DarkCyan"
                Clicked="OnSeleccionarImagenClicked"
                Text="Seleccionar imagen"
                TextColor="White" />

            <Button
                BackgroundColor="DarkCyan"
                Clicked="OnGuardarClicked"
                CornerRadius="24"
                FontAttributes="Bold"
                Text="Guardar mascota"
                TextColor="White" />

            <Button
                BackgroundColor="Transparent"
                Clicked="OnCancelarClicked"
                Text="Cancelar"
                TextColor="DarkCyan" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

