<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SegundaHuella.AnadirAnimalPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#FEF9F5"
    Title="Añadir mascota">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            
            <Label 
                FontAttributes="Bold" FontSize="30" Text="Añadir mascota" TextColor="#008F87" 
                />
            
            <Label
                Text="Completa los datos de la mascota para publicarla en adopción." TextColor="#555555" 
                />
            
            <Entry x:Name="NombreEntry" Placeholder="Nombre" TextColor="Black" />
            <Entry x:Name="EspecieEntry" Placeholder="Especie (perro, gato...)" TextColor="Black" />
            <Entry x:Name="EdadEntry" Placeholder="Edad" TextColor="Black" />
            <Entry x:Name="TamanoEntry" Placeholder="Tamaño" TextColor="Black" />

            <Button
                BackgroundColor="DarkCyan"
                Clicked="OnSeleccionarImagenClicked"
                Text="Seleccionar imagen"
                TextColor="White" />

            <Button 
                BackgroundColor="#008F87" 
                Clicked="OnGuardarClicked" 
                CornerRadius="24" 
                FontAttributes="Bold" 
                Text="Guardar mascota" 
                TextColor="White" />
            
            <Button 
                BackgroundColor="Transparent" 
                Clicked="OnCancelarClicked" 
                Text="Cancelar" 
                TextColor="#008F87" />
            
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

