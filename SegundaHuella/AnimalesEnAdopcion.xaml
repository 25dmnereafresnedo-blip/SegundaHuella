<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SegundaHuella.AnimalesEnAdopcion"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="AnimalesEnAdopcion">
    <VerticalStackLayout Padding="20" Spacing="16">
        <Label
            FontSize="32"
            HorizontalOptions="Center"
            Text="Animales en adopción"
            TextColor="#008F87"
            VerticalOptions="Center" />

        <Button
            x:Name="AnadirAnimalButton"
            BackgroundColor="Orange"
            Clicked="OnAnadirAnimalClicked"
            CornerRadius="24"
            FontAttributes="Bold"
            Text="+ Añadir mascota"
            TextColor="White" />

        <CollectionView x:Name="AnimalesCollectionView" EmptyView="Todavía no hay mascotas en adopción">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Margin="0,4"
                        Padding="16"
                        BackgroundColor="White"
                        Stroke="DarkCyan">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>

                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="16">

                            <Image
                                Grid.Column="0"
                                Aspect="AspectFill"
                                HeightRequest="180"
                                Source="{Binding Imagen}"
                                WidthRequest="250" />

                            <VerticalStackLayout Grid.Column="1" Spacing="7">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="22"
                                    Text="{Binding Nombre}"
                                    TextColor="Black" />

                                <Label Text="{Binding Especie, StringFormat='Especie: {0}'}" TextColor="Black" />

                                <Label Text="{Binding Edad, StringFormat='Edad: {0}'}" TextColor="Black" />

                                <Label Text="{Binding Tamaño, StringFormat='Tamaño: {0}'}" TextColor="Black" />

                                <Button
                                    BackgroundColor="DarkCyan"
                                    Clicked="OnVerMasClicked"
                                    CommandParameter="{Binding .}"
                                    FontAttributes="Bold"
                                    Text="Ver más"
                                    TextColor="White" />
                            </VerticalStackLayout>

                        </Grid>
                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </VerticalStackLayout>

</ContentPage>  