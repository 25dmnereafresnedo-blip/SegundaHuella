<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SegundaHuella.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <ScrollView BackgroundColor="White">
        <VerticalStackLayout Padding="30,35" Spacing="25">
            <Image
                Aspect="AspectFit"
                HeightRequest="300"
                Source="logo.png" />

            <Image
                Aspect="AspectFit"
                HeightRequest="120"
                Source="animales.png" />

            <Button
                BackgroundColor="Orange"
                Clicked="UsuarioClicked"
                CornerRadius="30"
                FontAttributes="Bold"
                FontSize="20"
                Text="Ver animales" />

            <Button
                BackgroundColor="White"
                BorderColor="DarkCyan"
                BorderWidth="3"
                Clicked="ProtectoraClicked"
                CornerRadius="30"
                FontAttributes="Bold"
                FontSize="20"
                Text="Soy una protectora"
                TextColor="DarkCyan" />
        </VerticalStackLayout>
    </ScrollView>
  
</ContentPage>

