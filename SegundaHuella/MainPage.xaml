<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SegundaHuella.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <ScrollView BackgroundColor="White">
        <VerticalStackLayout Padding="30,35" Spacing="30">
            <Image
                Aspect="AspectFit"
                HeightRequest="200"
                Source="logo.png" />

            <Label
                FontAttributes="Bold"
                FontSize="50"
                HorizontalOptions="Center"
                Text="SegundaHuella"
                VerticalOptions="Center" />

            <Label
                FontSize="23"
                HorizontalOptions="Center"
                Text="Adopte o acoge cerca de ti"
                VerticalOptions="Center" />

            <Image
                Aspect="AspectFit"
                HeightRequest="165"
                Source="animales.png" />

            <Button
                BackgroundColor="Orange"
                Clicked="UsuarioClicked"
                CornerRadius="30"
                FontAttributes="Bold"
                FontSize="20"
                Text="Ver animales" />

            <Button
                BackgroundColor="White"
                BorderColor="DarkCyan"
                BorderWidth="3"
                Clicked="ProtectoraClicked"
                CornerRadius="30"
                FontAttributes="Bold"
                FontSize="20"
                Text="Soy una protectora"
                TextColor="DarkCyan" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

